# ==============================================================================
# .gitignore - Tesis SAE pobreza monetaria municipal, Cauca y Valle del Cauca
# ==============================================================================

# ---- R y RStudio --------------------------------------------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/

# ---- Sistema operativo ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Archivos de bloqueo de Excel y Office -------------------------------------
~$*

# ---- Salidas --------------------------------------------------------------------
# Se regeneran al ejecutar los scripts. Se conservan la selección stepwise
# (tarda cerca de tres horas), las estimaciones finales y las figuras del anexo.
output/*
!output/seleccion_stepwise_completo_both.rds
!output/final_estimaciones_municipales_m1_log.csv
!output/figuras/
