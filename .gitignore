# ==============================================================================
# .gitignore - Tesis SAE pobreza monetaria municipal, Cauca y Valle del Cauca
# ==============================================================================

# ---- R y RStudio --------------------------------------------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/

# ---- Sistema operativo ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Archivos de bloqueo de Excel y Office -------------------------------------
~$*

# ---- Salidas --------------------------------------------------------------------
# Se regeneran al ejecutar los scripts. Se conservan la selección stepwise
# (tarda cerca de tres horas), las estimaciones finales y las figuras del anexo.
output/*
!output/seleccion_stepwise_completo_both.rds
!output/final_estimaciones_municipales_m1_log.csv
!output/figuras/
# Selección en escala logarítmica (sensibilidad del anexo; tarda horas).
!output/seleccion_kicb2_log.rds
# Estabilidad de la selección: resúmenes de las 57 corridas de la máquina
# virtual. Las corridas individuales, la caché y los registros no se suben.
!output/estabilidad_kicb2/
output/estabilidad_kicb2/*
!output/estabilidad_kicb2/estabilidad_*.csv
# Tablero interactivo, listo para abrir en el navegador.
!output/dashboard_pobreza.html
